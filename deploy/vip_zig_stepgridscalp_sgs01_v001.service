[Unit]
Description=VIP ZIG StepGridScalp v001 - SGS01
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading/strategy_pkg
EnvironmentFile=/home/ubuntu/trading/.env
ExecStart=/home/ubuntu/trading/runtime_env/bin/python /home/ubuntu/trading/strategy_pkg/run_step_grid_scalp_zig_sgs01_v001.py
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/trading/logs/vip_zig_stepgridscalp_sgs01_v001.log
StandardError=append:/home/ubuntu/trading/logs/vip_zig_stepgridscalp_sgs01_v001.log

[Install]
WantedBy=multi-user.target
