[Unit]
Description=StatArb Pairs (DOT-LINK, LINK-OP) on Bybit Spot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/trading/nautilus_env/bin/python /home/ubuntu/trading/scripts/runners/run_live_trading_statarb_pairs.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
