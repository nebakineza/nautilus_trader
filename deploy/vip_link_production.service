[Unit]
Description=VIP LINK Production - Lead/Lag Market Maker
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading
EnvironmentFile=/home/ubuntu/trading/.env
Environment=TRADER_ID=VIP1-PRODUCTION-LINK
Environment=NAUTILUS_LOG_DIR=/home/ubuntu/trading/logs
ExecStart=/home/seb/nebakineza/nautilus_trader/.venv/bin/python /home/ubuntu/trading/strategy_pkg/run_vip_link_production.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vip_link

[Install]
WantedBy=multi-user.target
